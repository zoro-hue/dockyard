FROM node:18-alpine

RUN apk add --no-cache git

WORKDIR /app

# Copy root files
COPY package.json package-lock.json* turbo.json ./

# Copy all workspace packages and apps
COPY packages/ ./packages/
COPY apps/ ./apps/

# Install dependencies
RUN npm install --legacy-peer-deps

# Build the web app
RUN npm run build --prefix apps/web

# Precompile custom Next.js Socket.IO server to JavaScript
RUN npx tsc -p apps/web/tsconfig.server.json

# Create shared storage directory
RUN mkdir -p /app/local-s3-bucket/builds /app/local-s3-bucket/outputs

ENV NODE_ENV=production
ENV LOCAL_S3_DIR=/app/local-s3-bucket

WORKDIR /app/apps/web

CMD ["node", "dist/server.js"]
